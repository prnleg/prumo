{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "ADR-036: dialogs + read/write of user-picked files only (no fs scope beyond what the dialog grants).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "dialog:allow-message",
    "fs:allow-read-file",
    "fs:allow-write-file"
  ]
}
