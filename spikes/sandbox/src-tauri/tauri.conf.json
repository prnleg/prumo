{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "spike-sandbox",
  "version": "0.0.0",
  "identifier": "org.prumo.spike-sandbox",
  "build": { "frontendDist": "../dist" },
  "app": {
    "windows": [{ "title": "Spike F", "width": 900, "height": 700 }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; worker-src 'self' blob:; frame-src 'self'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"] }
}
